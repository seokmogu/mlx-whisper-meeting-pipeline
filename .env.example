# HuggingFace token (for pyannote diarization models — gated)
HF_TOKEN=hf_your_token_here

# ─── Meeting projects ────────────────────────────────────────────────
# Space-separated list of project subdirectories under audio/, transcripts/, notes/.
# Each project is processed independently; you can mix personal and team meetings.
MEETING_PROJECTS="worxphere"

# This MacBook records only Worxphere meetings, so Voice Memo title/label does
# not affect routing. Every Voice Memo from this Mac is copied to audio/worxphere/.
VOICE_MEMO_FORCE_PROJECT=worxphere
# Optional fallback if FORCE_PROJECT is unset.
# VOICE_MEMO_ROUTING="worxphere:worxphere 웍스피어:worxphere"
# VOICE_MEMO_DEFAULT_PROJECT=worxphere
# VOICE_MEMO_USE_SEEN_STATE=1
# VOICE_MEMO_MIN_AGE_SECONDS=60

# Phone-recorded exceptions copied manually into this Mac.
# Put files under manual-audio/worxphere/*.m4a; the local pipeline moves them
# into audio/worxphere/ before transcription.
MANUAL_AUDIO_DIR=$HOME/project/mlx-whisper-meeting-pipeline/manual-audio
# MANUAL_AUDIO_MIN_AGE_SECONDS=60

# Recording quality guardrails.
# Adjacent unprocessed files within this gap are treated as stop/restart segments
# of one meeting and merged before transcription. Obvious silence/short files are
# quarantined under state/rejected-audio/, not deleted.
# AUDIO_PREP_MERGE_GAP_SECONDS=180
# AUDIO_PREP_MIN_DURATION_SECONDS=10
# AUDIO_PREP_REJECT_SILENCE_RATIO=0.98
# AUDIO_PREP_SILENCE_THRESHOLD=-35dB
# AUDIO_PREP_TRIM_OUTER_SILENCE=1
# AUDIO_PREP_TRIM_THRESHOLD=-35dB
# AUDIO_PREP_TRIM_SILENCE_DURATION=0.5
# AUDIO_PREP_TRIM_PADDING_SECONDS=0.4
# AUDIO_PREP_MIN_TRIM_SECONDS=1.0
# MEETING_MIN_TRANSCRIPT_CHARS=80

# ─── Meeting note LLM provider ───────────────────────────────────────
# Default note generator. Claude uses Claude Code OAuth; Codex uses the Codex CLI.
MEETING_LLM_PROVIDER=claude              # claude | codex
# Meeting notes are generated from a SKILL.md contract, not an inline prompt.
# Override only when testing another meeting-minute skill.
# MEETING_NOTES_SKILL=$HOME/project/mlx-whisper-meeting-pipeline/skills/meeting-minutes/SKILL.md
# Recent notes from the same project are excerpted so recurring meetings can
# populate Previous Action Follow-up and avoid duplicate actions.
# MEETING_PREVIOUS_NOTES_LIMIT=3
# MEETING_PREVIOUS_NOTE_MAX_LINES=160
# Optional comparison mode. The selected provider still writes notes/<project>/*.md;
# both provider outputs are saved under state/llm-comparisons/.
MEETING_LLM_COMPARE=0
# MEETING_LLM_COMPARE_DIR=$HOME/project/mlx-whisper-meeting-pipeline/state/llm-comparisons

# Claude Code OAuth settings used by sh/run-note-llm.sh.
# Auth is intentionally OAuth-based: claude-oauth print-token -> CLAUDE_CODE_OAUTH_TOKEN.
# Leave paths empty when commands are on PATH.
# CLAUDE_OAUTH_RUN=$HOME/.local/bin/claude-oauth-run
# CLAUDE_OAUTH_CLI=$HOME/.local/bin/claude-oauth
# highest resolves to Claude Code's opus alias; use default/profile to defer to Claude Code config.
CLAUDE_MODEL=highest
CLAUDE_EFFORT=highest
CLAUDE_TOOLS=WebSearch
# CLAUDE_MAX_BUDGET_USD=0.50

# Codex CLI settings used by sh/run-note-llm.sh.
# frontier resolves at runtime from OMX_DEFAULT_FRONTIER_MODEL, then ~/.codex/config.toml model.
# CODEX_BIN=/opt/homebrew/bin/codex
CODEX_MODEL=frontier
CODEX_REASONING_EFFORT=highest
CODEX_SEARCH=1
CODEX_SANDBOX=read-only
CODEX_APPROVAL_POLICY=never
CODEX_IGNORE_RULES=1

# Default project for Notion-imported transcripts (import-notion.sh / import-notion-api.sh).
NOTION_TARGET_PROJECT=worxphere

# ─── Notion (optional, for transcripts and roster) ───────────────────
# Pick ONE of the two import paths:
#   (a) import-notion-api.sh  — public Notion API. Set NOTION_TOKEN + NOTION_MEETING_DBS.
#   (b) import-notion.sh      — local notion.db SQLite (Mac Notion app cache). Needs NOTION_SPACE_ID.
NOTION_TOKEN=
NOTION_MEETING_DBS=               # comma-separated database IDs
# build_roster.sh requires these:
NOTION_SPACE_ID=00000000-0000-0000-0000-000000000000
ROSTER_EMAIL_DOMAIN=example.com   # filter workspace members by email domain

# Optional: upload newly generated Markdown notes back into a Notion database.
# Requires notion-native-toolkit configured with an API token profile.
# If NOTION_UPLOAD_DATABASE_ID is empty, upload is skipped.
NOTION_NATIVE_PROFILE=                  # blank = notion-native-toolkit default profile
NOTION_NATIVE_TOOLKIT_DIR=$HOME/project/notion-native-toolkit
NOTION_UPLOAD_DATABASE_ID=
# Optional select value for a "meeting type" property, if your DB has one.
# NOTION_UPLOAD_MEETING_TYPE=Internal

# ─── Remote compute host (Apple Silicon) ─────────────────────────────
# Tailscale/SSH alias for the optional remote host that runs Whisper + diarization + note LLM.
# Multiple candidates can be space-separated; run-remote.sh picks the first reachable one.
REMOTE_HOST=compute-host
# REMOTE_HOSTS="compute-host backup-host"

# ─── Speaker diarization ─────────────────────────────────────────────
# Community-1 requires pyannote.audio 4.x, so it runs from a separate venv to
# avoid breaking the mlx-whisper environment.
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Defaults to .venv-diar-test under this repository unless overridden.
# DIARIZATION_VENV=$HOME/project/mlx-whisper-meeting-pipeline/.venv-diar-test
DIARIZATION_NUM_SPEAKERS=2
DIARIZATION_EXCLUSIVE=1
